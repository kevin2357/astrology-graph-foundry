{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "davison_relationship_dataset",
  "type": "object",
  "required": [
    "metadata",
    "transitable_chart",
    "canonical_astrology_graph",
    "structural_evidence_graph",
    "projection_views",
    "semantic_boundary"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "schema_version",
        "analysis_type"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "pipeline_version": {
          "type": "string"
        },
        "analysis_type": {
          "const": "davison_relationship_dataset"
        },
        "created_at": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "transitable_chart": {
      "$ref": "transitable_chart_v1.schema.json"
    },
    "canonical_astrology_graph": {
      "$ref": "canonical_astrology_graph_v1.schema.json"
    },
    "structural_evidence_graph": {
      "$ref": "structural_evidence_graph_v1.schema.json"
    },
    "projection_views": {
      "type": "object",
      "required": [
        "orthodox_astrology.v1"
      ],
      "properties": {
        "orthodox_astrology.v1": {
          "$ref": "orthodox_astrology_projection_view_v1.schema.json"
        }
      }
    },
    "semantic_boundary": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
