{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Birth Data v1",
  "type": "object",
  "required": [
    "name",
    "birth_local",
    "birth_timezone",
    "birth_lat",
    "birth_lon"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "birth_local": {
      "type": "string"
    },
    "birth_timezone": {
      "type": "string"
    },
    "birth_lat": {
      "type": "number"
    },
    "birth_lon": {
      "type": "number"
    },
    "birth_location_label": {
      "type": "string"
    },
    "source_chart_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    }
  },
  "additionalProperties": false
}
