{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Astrology Graph v1",
  "type": "object",
  "required": [
    "graph_type",
    "graph_version",
    "source_sensor_id",
    "projection_status",
    "objects",
    "relationships",
    "sensor_instance_id",
    "source_chart_ids"
  ],
  "properties": {
    "graph_type": {
      "const": "canonical_astrology_graph"
    },
    "graph_version": {
      "const": "1.3.0"
    },
    "source_sensor_id": {
      "type": "string"
    },
    "projection_status": {
      "const": "pre_projection"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "evidence_metadata",
          "structural_strength_score"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "evidence_metadata": {
            "$ref": "evidence_provenance_v1.schema.json"
          },
          "structural_strength_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "operator_hints": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "evidence_metadata",
          "structural_strength_score"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "evidence_metadata": {
            "$ref": "evidence_provenance_v1.schema.json"
          },
          "structural_strength_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "operator_hints": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object"
    },
    "indexes": {
      "type": "object"
    },
    "boundary_notes": {
      "type": "object"
    },
    "nested_canonical_graph_registry": {
      "type": "object",
      "additionalProperties": {
        "$ref": "canonical_astrology_graph_v1.schema.json"
      }
    },
    "sensor_instance_id": {
      "type": "string"
    },
    "source_chart_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_chart_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "additionalProperties": true
}
