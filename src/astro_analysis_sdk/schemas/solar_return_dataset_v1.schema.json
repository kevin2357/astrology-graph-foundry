{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solar Return Dataset v2",
  "type": "object",
  "required": [
    "metadata",
    "target",
    "return_location",
    "return_event",
    "return_chart",
    "canonical_astrology_graph",
    "structural_evidence_graph",
    "projection_views",
    "semantic_boundary"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "schema_version",
        "pipeline_version",
        "analysis_type",
        "created_at",
        "target_chart_id",
        "target_chart_type",
        "semantic_scope",
        "return_year",
        "return_location_policy"
      ],
      "properties": {
        "analysis_type": {
          "const": "solar_return_dataset"
        },
        "return_location_policy": {
          "enum": [
            "target_reference",
            "explicit"
          ]
        }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object"
    },
    "return_event": {
      "type": "object",
      "required": [
        "event_utc",
        "target_sun_longitude",
        "method"
      ]
    },
    "return_chart": {
      "type": "object"
    },
    "return_location": {
      "type": "object",
      "required": [
        "policy",
        "timezone",
        "lat",
        "lon",
        "location_label",
        "source"
      ],
      "properties": {
        "policy": {
          "enum": [
            "target_reference",
            "explicit"
          ]
        },
        "timezone": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "location_label": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "canonical_astrology_graph": {
      "$ref": "canonical_astrology_graph_v1.schema.json"
    },
    "structural_evidence_graph": {
      "$ref": "structural_evidence_graph_v1.schema.json"
    },
    "projection_views": {
      "type": "object",
      "required": [
        "orthodox_astrology.v1"
      ],
      "properties": {
        "orthodox_astrology.v1": {
          "$ref": "orthodox_astrology_projection_view_v1.schema.json"
        }
      }
    },
    "semantic_boundary": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
